# Copia este archivo a .env.local y rellena los valores.
# Para Edge Functions en Supabase, configura los secrets con:
#   supabase secrets set STRIPE_SECRET_KEY=sk_test_...
#   supabase secrets set STRIPE_WEBHOOK_SIGNING_SECRET=whsec_...
#   supabase secrets set RESEND_API_KEY=re_...
#   supabase secrets set SUPABASE_SERVICE_ROLE_KEY=eyJ...
#   supabase secrets set RESEND_FROM_EMAIL=notifications@tudominio.com
#   supabase secrets set CLIENT_URL=https://tu-app.com
#   supabase secrets set TRADE_COUPON_ID=coupon_...   # cupón 15% Trade Program (Stripe)
#   supabase secrets set ADMIN_EMAILS=admin@bridgearg.net
#   supabase secrets set BREVO_API_KEY=xkeysib-...
#   supabase secrets set BREVO_LIST_ID=123
#
# Para desarrollo local: supabase functions serve --env-file ./supabase/functions/.env.local

STRIPE_SECRET_KEY=sk_test_...
#
# ⚠️ ANTES DE PRODUCCIÓN: asegurate de setear STRIPE_SECRET_KEY con sk_live_...
# (si queda sk_test_ en producción, ningún comprador real podrá completar el pago).
STRIPE_WEBHOOK_SIGNING_SECRET=whsec_...
RESEND_API_KEY=re_...
TRADE_COUPON_ID=coupon_...
ADMIN_EMAILS=admin@bridgearg.net
BREVO_API_KEY=xkeysib-...
BREVO_LIST_ID=123
