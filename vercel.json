{
  "redirects": [
    { "source": "/collection", "destination": "/artworks", "permanent": true },
    { "source": "/artworks/4", "destination": "/artworks", "permanent": true },
    { "source": "/nosotros", "destination": "/about", "permanent": true },
    { "source": "/contacto", "destination": "/contact", "permanent": true },
    { "source": "/artistas", "destination": "/artists", "permanent": true },
    { "source": "/works", "destination": "/artworks", "permanent": true }
  ],
  "rewrites": [
    { "source": "/checkout/:path*", "destination": "/index.html" },
    { "source": "/verify/:path*", "destination": "/index.html" },
    { "source": "/legal", "destination": "/index.html" },
    { "source": "/admin/:path*", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
